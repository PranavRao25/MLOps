name: Image_Classifier
conda_env: conda.yaml

entry_points:
  load_data:
    command: "python3 src/utils/load.py"
  mail:
    command: "python3 src/utils/mail.py"
  main:
    parameters:
      lr: {type: float, default: 0.0001}
      epochs: {type: int, default: 2}
      wgt_decay: {type: float, default: 0.01}
    command: "python3 src/train.py --lr {lr} --epochs {epochs} --wgt_decay {wgt_decay}"
